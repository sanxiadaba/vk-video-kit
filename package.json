{
  "name": "vk-video-kit",
  "version": "12.0.0",
  "description": "把内容做成画面单元：37 个 HTML 标签、5 层、1920×1080，桌面 only；展示站是一本自举的标本册。",
  "main": "dist/vk.esm.js",
  "module": "dist/vk.esm.js",
  "types": "types/index.d.ts",
  "scripts": {
    "build": "node tools/icons.mjs && node tools/fonts.mjs && node tools/katex.mjs && node tools/gen.mjs && node tools/ai-doc.mjs && node tools/build.mjs && node tools/assemble.mjs && node tools/scenes.mjs && node tools/specimens.mjs && node tools/stamp.mjs && node cli/build.mjs _site/specimens && node cli/build.mjs _site/specimen && node tools/thumbs.mjs && node cli/build.mjs _site/index.html",
    "gen": "node tools/gen.mjs",
    "ai": "node tools/ai-doc.mjs",
    "links": "node tools/links.mjs",
    "contract": "node tools/contract-all.mjs",
    "contract:one": "node tools/contract.mjs",
    "scenes": "node tools/scenes.mjs",
    "assemble": "node tools/assemble.mjs",
    "specimens": "node tools/specimens.mjs",
    "precompile": "node cli/build.mjs",
    "serve": "node cli/serve.mjs 8099 _site",
    "dev": "npm run build && node tools/dev.mjs",
    "slice": "node cli/build.mjs slice/frames && node tools/plan.mjs slice/deck.json",
    "plan": "node tools/plan.mjs",
    "box": "node tools/box-tree.mjs",
    "shot": "node tools/shot.mjs",
    "quick": "node tools/quick.mjs",
    "gate": "node tools/gate-all.mjs",
    "gate:full": "node tools/gate-all.mjs --full",
    "gate:visual": "node tools/gate-all.mjs --presets",
    "gate:one": "node tools/gate.mjs",
    "verify": "node tools/verify.mjs",
    "check": "node tools/verify.mjs",
    "lint": "node tools/lint.mjs",
    "format": "prettier --write \"tools/**/*.mjs\" \"tests/**/*.mjs\" \"package.json\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"tools/**/*.mjs\" \"tests/**/*.mjs\" \"package.json\" \".github/**/*.yml\"",
    "test": "node tools/test-all.mjs",
    "test:fast": "node tools/test-all.mjs --fast",
    "icons": "node tools/icons.mjs",
    "fonts": "node tools/fonts.mjs"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "parse5": "^7.3.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "esbuild": "^0.28.2",
    "lucide": "^1.61.0",
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10"
  },
  "license": "MIT",
  "author": "jun",
  "type": "module",
  "bin": {
    "vk": "bin/vk.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}