{
  "name": "vk-video-kit",
  "version": "16.0.0",
  "private": true,
  "description": "把内容做成画面单元：30 个标签、一层（元素 / 排布 / 数据 / 关系 / 页面）、1920×1080。",
  "type": "module",
  "main": "dist/vk.esm.js",
  "module": "dist/vk.esm.js",
  "bin": {
    "vk": "bin/vk.mjs"
  },
  "scripts": {
    "build": "node tools/icons.mjs && node tools/fonts.mjs && node tools/katex.mjs && node tools/build.mjs",
    "fixtures": "node tools/fixtures.mjs",
    "gallery": "node tools/gallery.mjs",
    "check": "node bin/vk.mjs check pages",
    "shot": "node bin/vk.mjs shot",
    "test": "npm run build && node tools/test.mjs",
    "test:fast": "node tools/test.mjs --fast",
    "budget": "node tools/budget.mjs"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "parse5": "^7.3.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "esbuild": "^0.28.2",
    "lucide": "^1.61.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  },
  "license": "MIT",
  "author": "jun",
  "engines": {
    "node": ">=20"
  }
}
